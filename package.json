{
  "name": "economy-education-game",
  "version": "0.0.1",
  "private": true,
  "description": "Elementary market-economy education game: headless economy engine + future classroom UI/multiplayer.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx scripts/simulate-7-rounds.ts",
    "simulate:class": "tsx scripts/simulate-class.ts",
    "simulate:smoke": "tsx scripts/simulate-7-rounds.ts --smoke",
    "validate:economy": "tsx scripts/validate-economy.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
