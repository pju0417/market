{
  "name": "economy-education-game",
  "version": "0.0.1",
  "private": true,
  "description": "Elementary market-economy education game: headless economy engine + future classroom UI/multiplayer.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json && tsc -p tsconfig.appsScript.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx scripts/simulate-7-rounds.ts",
    "simulate:class": "tsx scripts/simulate-class.ts",
    "simulate:smoke": "tsx scripts/simulate-7-rounds.ts --smoke",
    "validate:economy": "tsx scripts/validate-economy.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:apps-script": "tsx scripts/build-apps-script.ts"
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
